rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection - PIN hashes
    // Anyone can read their own doc (for PIN verification)
    // Only the system writes (via app logic, no auth required for internal app)
    match /users/{userId} {
      allow read, write: if true; // Internal app - all users trusted
    }

    // Reclamații - all authenticated app users can read
    // Operators can write their own location's data
    match /reclamatii/{docId} {
      allow read, write: if true;
    }

    // Soferi
    match /soferi/{docId} {
      allow read, write: if true;
    }

    // Pachete livrate
    match /pachete_livrate/{docId} {
      allow read, write: if true;
    }

    // Rechnunguri
    match /rechnunguri/{docId} {
      allow read, write: if true;
    }
  }
}
